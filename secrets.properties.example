# Copy this file to secrets.properties and replace the placeholder.
# secrets.properties is git-ignored — never commit your real key.
#
# In Google Cloud Console (https://console.cloud.google.com/):
# 1. APIs & Services → Library → enable ALL of:
#    - Maps SDK for Android
#    - Places API
#    - Directions API
# 2. Credentials → Create API key → restrict to Android apps
#    Package: com.cybersec.smartroute
#    SHA-1: obtain via ./gradlew signingReport
#
MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
