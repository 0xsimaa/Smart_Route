# Copy this file to secrets.properties and replace the placeholder.
# secrets.properties is git-ignored — never commit your real key.
#
# 1. https://console.cloud.google.com/ → APIs & Services → Library
# 2. Enable "Maps SDK for Android"
# 3. Credentials → Create API key → restrict to Android + package com.cybersec.smartroute
#
MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
